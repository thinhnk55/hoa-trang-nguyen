---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import TrainingClient from '../../../components/TrainingClient.astro'
---

<BaseLayout title="Kết quả ôn tập | Học Nhé" description="Xem kết quả bộ đề ôn tập Văn Miếu - Quốc Tử Giám.">
  <section class="result-card" data-result-page>
    <span class="eyebrow">Kết quả ôn tập</span>
    <h1 data-result-title>Hoàn thành lượt ôn tập</h1>
    <p data-result-summary></p>
    <div class="result-stats" data-result-stats></div>
    <div class="result-actions">
      <button class="button button-primary" type="button" data-retry-all>Làm lại toàn bộ</button>
      <button class="button button-secondary" type="button" data-retry-wrong hidden>Ôn câu sai</button>
      <a class="button button-quiet" href="/">Về trang chủ</a>
    </div>
  </section>
  <TrainingClient />
</BaseLayout>
